@page
@model Bethel_Heritage_Portal_Web.Pages.finance.PtaPaymentsModel
@{
    ViewData["Title"] = "PTA Payments";
    ViewData["ActivePage"] = "pta-fees";
}
@section Styles {
    <partial name="_dataTablesSheets" />
}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center">
        <h5 class="mb-0">PTA Payment History</h5>
        <input type="text" id="pta-fees-search" class="form-control form-control-sm w-auto" placeholder="Search..." onkeyup="filterTable('pta-fees-table', this.value)">
    </div>
    <div class="card-body">
        <table id="pta-fees-table" class=" table table-boredered table-striped table-sm" width="100%">
            <thead class="">
                <tr>
                    <th>#</th>
                    <th>Student Name</th>
                    <th>PTA Fees</th>
                    <th>Paid</th>
                    <th>Balance</th>
                    <th>Term</th>
                    <th>Session/Year</th>
                    <th>Class</th>
                    <th>Date</th>
                </tr>
            </thead>
        </table>

    </div>
</div>
@section Scripts {
    <partial name="_dataTablesScripts" />
    <script src="~/js/site.js"></script>
}