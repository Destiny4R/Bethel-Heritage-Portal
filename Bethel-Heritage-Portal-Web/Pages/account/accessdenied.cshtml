@page
@model Bethel_Heritage_Portal_Web.Pages.account.accessdeniedModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>403 Access Denied</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts (Inter & JetBrains Mono for code look) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.7);
            --accent-color: #ef4444; /* Red for danger/denied */
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
        }

        body {
            background-color: var(--bg-color);
            background-image: radial-gradient(at 0% 0%, hsla(253,16%,7%,1) 0, transparent 50%), radial-gradient(at 50% 0%, hsla(225,39%,30%,1) 0, transparent 50%), radial-gradient(at 100% 0%, hsla(339,49%,30%,1) 0, transparent 50%);
            font-family: 'Inter', sans-serif;
            color: var(--text-primary);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
        }

        /* Glassmorphism Card */
        .error-card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            padding: 3rem 2rem;
            text-align: center;
            max-width: 600px;
            width: 90%;
            position: relative;
            z-index: 10;
        }

        /* The Big 403 Background Text */
        .error-code-bg {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.03);
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: -1;
            pointer-events: none;
            line-height: 1;
        }

        /* Icon Styling & Animation */
        .lock-icon-wrapper {
            font-size: 4rem;
            color: var(--accent-color);
            margin-bottom: 1.5rem;
            display: inline-block;
        }

        .fa-shield-halved {
            animation: pulse-red 3s infinite ease-in-out;
        }

        .fa-lock {
            animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
            transform-origin: center bottom;
        }

        /* Typography */
        h1 {
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 1rem;
        }

        p.lead {
            color: var(--text-secondary);
            font-weight: 400;
            margin-bottom: 2.5rem;
            font-size: 1.1rem;
        }

        /* Buttons */
        .btn-custom {
            padding: 0.75rem 2rem;
            border-radius: 8px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .btn-primary-custom {
            background-color: var(--accent-color);
            border-color: var(--accent-color);
            color: white;
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
        }

            .btn-primary-custom:hover {
                background-color: #dc2626;
                border-color: #dc2626;
                box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
                transform: translateY(-2px);
            }

        .btn-outline-custom {
            background-color: transparent;
            border-color: rgba(255, 255, 255, 0.2);
            color: var(--text-primary);
        }

            .btn-outline-custom:hover {
                background-color: rgba(255, 255, 255, 0.05);
                border-color: rgba(255, 255, 255, 0.4);
                color: white;
            }

        /* Support Text */
        .support-text {
            margin-top: 2rem;
            font-size: 0.875rem;
            color: #64748b;
        }

            .support-text a {
                color: #94a3b8;
                text-decoration: none;
                transition: color 0.2s;
            }

                .support-text a:hover {
                    color: var(--accent-color);
                }

        /* Animations */
        @@keyframes shake {
            10%, 90% {
                transform: translate3d(-1px, 0, 0);
            }

            20%, 80% {
                transform: translate3d(2px, 0, 0);
            }

            30%, 50%, 70% {
                transform: translate3d(-4px, 0, 0);
            }

            40%, 60% {
                transform: translate3d(4px, 0, 0);
            }
        }

        @@keyframes pulse-red {
            0% {
                text-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
            }

            70% {
                text-shadow: 0 0 0 15px rgba(239, 68, 68, 0);
            }

            100% {
                text-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
            }
        }

        /* Decorative particles (simple CSS shapes) */
        .particle {
            position: absolute;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
            z-index: 1;
        }
    </style>
</head>
<body>

    <!-- Decorative background particles -->
    <div class="particle" style="top: 20%; left: 20%; width: 100px; height: 100px;"></div>
    <div class="particle" style="bottom: 15%; right: 15%; width: 150px; height: 150px;"></div>

    <main class="container d-flex justify-content-center align-items-center h-100">
        <div class="error-card">
            <!-- Ghost 403 text in background -->
            <div class="error-code-bg">403</div>

            <!-- Animated Icon -->
            <div class="lock-icon-wrapper">
                <i class="fa-solid fa-shield-halved"></i>
                <i class="fa-solid fa-lock ms-3" style="font-size: 2.5rem;"></i>
            </div>

            <!-- Main Content -->
            <h1>Access Denied</h1>
            <p class="lead">
                You don't have permission to view this page. <br>
                Please check your credentials or contact your system administrator.
            </p>

            <!-- Action Buttons -->
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                <a asp-page="/account/login" class="btn btn-primary-custom btn-custom shadow-sm">
                    <i class="fa-solid fa-house me-2"></i> Back to Home
                </a>
                <button onclick="history.back()" class="btn btn-outline-custom btn-custom">
                    <i class="fa-solid fa-arrow-left me-2"></i> Go Back
                </button>
            </div>

            <!-- Help Footer -->
            <div class="support-text">
                Need help? <a href="#">Contact Support</a> or reference <span style="font-family: 'JetBrains Mono', monospace;">Error Code: 0x403_AUTH</span>
            </div>
        </div>
    </main>

    <!-- Bootstrap Bundle JS (Optional, for button interactions if needed) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>